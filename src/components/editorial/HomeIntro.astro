---
import ResponsiveImage from '../ResponsiveImage.astro';
import type { HomeIntroProps } from '../../lib/content/editorial';
type Props = HomeIntroProps & { imageOrder: number };
const {
  key,
  image,
  alt,
  imageOrder,
  tone = 'dark',
  mobileMenuTone = tone,
  hideNavigation = false,
  imagePosition = 'center top',
  mobileImagePosition = imagePosition,
} = Astro.props;
---

<section
  id={key}
  class="home-section home-intro"
  data-home-section={key}
  data-control-tone={tone}
  data-mobile-menu-tone={mobileMenuTone}
  data-hide-navigation={String(hideNavigation)}
  style={{
    '--home-image-position': imagePosition,
    '--home-mobile-image-position': mobileImagePosition,
  }}
>
  <div class="home-panel home-left home-copy">
    <div class="home-text">
      <span id="regenerativeFrameWork"></span>
      <span id="susannePreissCoaching"></span>
      <slot />
    </div>
  </div>
  <div class="home-panel home-right home-image">
    <ResponsiveImage
      src={image}
      alt={alt}
      sizes="(max-aspect-ratio: 1/1) 100vw, 50vw"
      loading={imageOrder < 2 ? 'eager' : 'lazy'}
      fetchpriority={imageOrder === 0 ? 'high' : 'auto'}
    />
    <span class="home-logo" aria-hidden="true"></span>
    <span class="scroll-hint" aria-hidden="true"></span>
  </div>
</section>
