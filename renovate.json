{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "enabledManagers": ["npm", "github-actions"],
  "includePaths": ["package.json", "pnpm-workspace.yaml", ".github/workflows/*.yml"],
  "ignorePaths": [
    "**/node_modules/**",
    ".scratch/**",
    ".fixture-*/**",
    "dist/**",
    ".astro/**",
    ".pi/**",
    ".agents/**"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["* 0-5 * * 1"],
  "updateNotScheduled": false,
  "prHourlyLimit": 2,
  "prConcurrentLimit": 3,
  "branchConcurrentLimit": 3,
  "rebaseWhen": "conflicted",
  "rangeStrategy": "bump",
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-5 * * 1"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "groupName": null,
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Keep compatible framework and integrations together; always review.",
      "matchPackageNames": [
        "astro",
        "@astrojs/**",
        "svelte",
        "svelte-check",
        "@sveltejs/**",
        "prettier-plugin-astro"
      ],
      "groupName": "Astro and Svelte"
    },
    {
      "description": "Review player packages together, including coordinated majors.",
      "matchPackageNames": ["@videojs/**"],
      "groupName": "Video.js"
    },
    {
      "matchPackageNames": ["@fontsource/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "fonts"
    },
    {
      "description": "Update both native pnpm pins together; synchronize Cloudflare manually.",
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm"
    },
    {
      "description": "Runtime changes require review and Cloudflare build-variable updates.",
      "matchDepNames": ["node", "@types/node"],
      "groupName": "Node.js"
    },
    {
      "description": "Only this small stable tooling allowlist is eligible for automerge.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["prettier", "ignore", "@types/css-tree"],
      "matchCurrentVersion": ">=1.0.0",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "stable tooling",
      "automerge": true
    },
    {
      "description": "Lockfile refreshes are eligible only after the owner enables the policy.",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "automerge": true
    },
    {
      "description": "Pre-1.0 releases, majors and replacements always need human review.",
      "matchCurrentVersion": "<1.0.0",
      "automerge": false
    },
    {
      "description": "Never authorize prerelease updates automatically.",
      "matchNewValue": "/-/",
      "automerge": false
    },
    {
      "matchUpdateTypes": ["major", "replacement", "rollback"],
      "automerge": false
    },
    {
      "description": "ACTIVATION SAFETY LATCH: remove only after owner verifies required-check enforcement; see docs/dependency-maintenance.md.",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest",
        "lockFileMaintenance",
        "replacement",
        "rollback"
      ],
      "automerge": false
    }
  ]
}
